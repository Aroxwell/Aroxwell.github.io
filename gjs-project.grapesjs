e,transform .28s ease","font-family":"'Space Grotesk',sans-serif","font-size":"22px","font-weight":"700","line-height":"1","color":"currentColor"},"state":":after"},{"selectors":[],"selectorsAdd":".hero-submit.is-loading #ikjsyp, .hero-submit.is-success #ikjsyp","style":{"opacity":"0","transform":"scale(.7)"}},{"selectors":[],"selectorsAdd":".hero-submit #ikjsyp","style":{"transition":"opacity .18s ease,transform .22s ease"}},{"selectors":["hero-submit","is-loading"],"style":{"opacity":"1"},"state":":before"},{"selectors":["hero-submit","is-success"],"style":{"opacity":"1","animation":"hero-pop .42s ease-out"},"state":":after"},{"selectors":["hero-submit"],"style":{"cursor":"default"},"state":"disabled"},{"selectors":["hero-note","is-success"],"style":{"color":"rgba(232,221,192,0.92)"}},{"selectors":[],"selectorsAdd":"to","style":{"transform":"translate(-50%,-50%) rotate(360deg)"},"mediaText":"hero-spin","atRuleType":"keyframes"},{"selectors":[],"selectorsAdd":"0%","style":{"transform":"translate(-50%,-50%) scale(.72)"},"mediaText":"hero-pop","atRuleType":"keyframes"},{"selectors":[],"selectorsAdd":"55%","style":{"transform":"translate(-50%,-50%) scale(1.18)"},"mediaText":"hero-pop","atRuleType":"keyframes"},{"selectors":[],"selectorsAdd":"100%","style":{"transform":"translate(-50%,-50%) scale(1)"},"mediaText":"hero-pop","atRuleType":"keyframes"},{"selectors":["hero-submit"],"style":{"width":"16px","height":"16px"},"mediaText":"(max-width: 480px)","state":":before","atRuleType":"media"},{"selectors":["hero-submit"],"style":{"font-size":"20px"},"mediaText":"(max-width: 480px)","state":":after","atRuleType":"media"}],"pages":[{"name":"PixelCraft Landing Page","frames":[{"component":{"type":"wrapper","classes":["gjs-t-body"],"attributes":{"id":"ibody"},"components":[{"tagName":"section","name":"Navigation Section","classes":["gjs-section"],"attributes":{"id":"inav"},"components":[{"name":"Navigation Container","classes":["gjs-container"],"attributes":{"id":"inavcnt"},"components":[{"name":"Navigation Wrapper","classes":["navbar"],"attributes":{"id":"ivc9hd"},"components":[{"name":"Navbar","classes":["navbar-cnt"],"attributes":{"data-gjs":"navbar","id":"inv46c"},"components":[{"type":"link","editable":false,"classes":["navbar-brand"],"attributes":{"href":"/"},"components":[{"type":"heading","name":"Brand Logo","attributes":{"id":"ilogo"},"components":[{"type":"image","name":"Logo Image","resizable":{"ratioDefault":1},"attributes":{"src":"https://cdn.grapesjs.com/workspaces/cmsibyhli0w0x13hqnfivudh5/assets/e5ce0670-2046-4596-a2f7-99ded15d7bb0__logo.png","alt":"Aroxwell logo","id":"ipm0wc"}}]}]},{"classes":["navbar-items-c"],"attributes":{"data-gjs":"navbar-items"}}]}]}]}]},{"tagName":"section","name":"Hero Section","classes":["gjs-section"],"attributes":{"id":"ihero"},"components":[{"name":"Hero Container","classes":["gjs-container"],"attributes":{"id":"iherocnt"},"components":[{"type":"flex-row","name":"Hero Row","classes":["gjs-plg-flex-row"],"attributes":{"data-type-role":"flex-row","id":"iherorow"},"components":[{"type":"flex-column","name":"Hero Content Column","classes":["gjs-plg-flex-column","hero-shell","hero-copy"],"attributes":{"data-type-role":"flex-column","id":"iherocol1"},"components":[{"type":"heading","name":"Hero Title","classes":["gjs-t-h1"],"attributes":{"id":"iherotitle-2"},"components":[{"tagName":"span","type":"text","classes":["hero-title-top"],"attributes":{"id":"itf44k"},"components":[{"type":"textnode","content":"GET YOUR"}]},{"tagName":"span","type":"text","classes":["hero-title-script"],"attributes":{"id":"iw4xyt"},"components":[{"type":"textnode","content":"action plan"}]}]},{"tagName":"span","type":"text","attributes":{"id":"iherotext-2-2"},"components":[{"type":"textnode","content":"\n              A practical action framework inspired by The War of Art to help you overcome resistance and start meaningful work.\n            "}]},{"type":"flex-row","classes":["gjs-plg-flex-row"],"attributes":{"data-type-role":"flex-row","id":"iherobtnrow-2-2"},"components":[{"classes":["hero-form-wrap"],"attributes":{"id":"icuw4f-2-2"},"components":[{"type":"form","classes":["hero-form"],"attributes":{"id":"i9xpxk-2-2"},"components":[{"type":"input","void":true,"classes":["hero-input"],"attributes":{"type":"email","name":"email","placeholder":"Enter your email address","autocomplete":"email","aria-label":"Email address","required":true,"id":"isxk5f-2-2"}},{"type":"button","classes":["gjs-t-button","hero-submit"],"attributes":{"type":"submit","id":"ini249-2-2"},"components":[{"tagName":"span","type":"text","attributes":{"id":"ikjsyp"},"components":[{"type":"textnode","content":"→"}]}]}]},{"tagName":"p","type":"text","classes":["hero-note"],"attributes":{"id":"ifqksh-2-2"},"components":[{"type":"textnode","content":"No spam. Unsubscribe anytime."}]}]}],"snap":"","snap-divisions":12},{"classes":["hero-divider"],"attributes":{"id":"ibdk5j-2-2"}}]}],"snap":"","snap-divisions":12}]}]},{"type":"script","attributes":{"id":"ic2m2o"},"components":[{"type":"textnode","content":"\n      document.getElementById(\"i9xpxk-2-2\").addEventListener(\"submit\", async function(event) {\n        event.preventDefault();\n\n        const form = event.target;\n        const email = form.email.value;\n        const button = form.querySelector(\"button\");\n        const note = document.getElementById(\"ifqksh-2-2\");\n        const defaultNote = \"No spam. Unsubscribe anytime.\";\n        const successNote = \"You're in - check your inbox for an email\";\n\n        button.disabled = true;\n        button.classList.remove(\"is-success\");\n        button.classList.add(\"is-loading\");\n        note.classList.remove(\"is-success\");\n        note.textContent = defaultNote;\n\n        try {\n          const response = await fetch(\"https://aroxwell-email.aroxwellbusiness.workers.dev\", {\n            method: \"POST\",\n            headers: {\n              \"Content-Type\": \"application/json\"\n            },\n            body: JSON.stringify({\n              email: email\n            })\n          });\n\n          const result = await response.json();\n\n          if (result.success) {\n            form.reset();\n            button.classList.remove(\"is-loading\");\n            button.classList.add(\"is-success\");\n            note.textContent = successNote;\n            note.classList.add(\"is-success\");\n          } else {\n            button.classList.remove(\"is-loading\");\n            alert(JSON.stringify(result));\n          }\n\n        } catch (error) {\n          button.classList.remove(\"is-loading\");\n          alert(\"Something went wrong. Please try again.\");\n        }\n\n        button.disabled = false;\n      });\n    "}]}],"doctype":"<!DOCTYPE html>","head":{"type":"head","components":[{"tagName":"title","type":"text","components":[{"type":"textnode","content":"PixelCraft | AI Web & Project Development"}]},{"tagName":"meta","void":true,"attributes":{"charset":"utf-8"}},{"tagName":"meta","void":true,"attributes":{"name":"viewport","content":"width=device-width, initial-scale=1.0"}},{"tagName":"meta","void":true,"attributes":{"name":"robots","content":"index,follow"}},{"tagName":"meta","void":true,"attributes":{"name":"generator","content":"GrapesJS Studio"}},{"tagName":"link","void":true,"attributes":{"rel":"stylesheet","href":"./style.css"}}]},"docEl":{"tagName":"html","attributes":{"lang":"en"}}},"id":"jkk3ho66EOEDf3yW","minHeight":"500px"}],"id":"qOXhd2qXMJpkTYgv"}],"symbols":[],"custom":{"projectType":"web","id":""}}